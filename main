    ];

    let currentTrackIndex = 0;
    let isPlaying = false;
    let isShuffle = false;
    let loopState = 0;
    let lastVolume = 0.8;

    const themes = ['', 'light', 'purple', 'emerald', 'sunset', 'crimson'];
    let currentThemeIndex = 0;

    const playerCard = document.getElementById('player-card');
    const ambientBg = document.getElementById('ambient-bg');
    const themeToggleBtn = document.getElementById('theme-toggle-btn');
    const audio = document.getElementById('audio');
    const playBtn = document.getElementById('play-btn');
    const playIcon = document.getElementById('play-icon');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const shuffleBtn = document.getElementById('shuffle-btn');
    const loopBtn = document.getElementById('loop-btn');
    const loopBadge = document.getElementById('loop-badge');
    const titleContainer = document.getElementById('title-container');
    const title = document.getElementById('title');
    const artist = document.getElementById('artist');
    const albumArt = document.getElementById('album-art');
    const progressBar = document.getElementById('progress-bar');
    const progressWrapper = document.getElementById('progress-wrapper');
    const currentTimeEl = document.getElementById('current-time');
    const durationEl = document.getElementById('duration');
    const volumeSlider = document.getElementById('volume-slider');
    const volumeIcon = document.getElementById('volume-icon');
    const volumeProgressV = document.getElementById('volume-progress-v');
    const playlistEl = document.getElementById('playlist');
    
    const playlistPanel = document.getElementById('playlist-panel');
    const playlistToggleBtn = document.getElementById('playlist-toggle-btn');
    const playlistCloseBtn = document.getElementById('playlist-close-btn');
    const equalizer = document.getElementById('equalizer');

    const savedTheme = localStorage.getItem('sz_player_theme');
    if (savedTheme) {
      currentThemeIndex = themes.indexOf(savedTheme);
      if (currentThemeIndex === -1) currentThemeIndex = 0;
      applyTheme(themes[currentThemeIndex]);
    }

    function applyTheme(themeName) {
      if (themeName) {
        playerCard.setAttribute('data-theme', themeName);
      } else {
        playerCard.removeAttribute('data-theme');
      }
      localStorage.setItem('sz_player_theme', themeName);
    }

    themeToggleBtn.addEventListener('click', () => {
      currentThemeIndex = (currentThemeIndex + 1) % themes.length;
      applyTheme(themes[currentThemeIndex]);
    });

    shuffleBtn.addEventListener('click', () => {
      isShuffle = !isShuffle;
      shuffleBtn.classList.toggle('active-mode', isShuffle);
    });

    loopBtn.addEventListener('click', () => {
      loopState = (loopState + 1) % 3;
      if (loopState === 0) {
        loopBtn.classList.remove('active-mode');
        loopBadge.style.display = 'none';
      } else if (loopState === 1) {
        loopBtn.classList.add('active-mode');
        loopBadge.style.display = 'none';
      } else if (loopState === 2) {
        loopBtn.classList.add('active-mode');
        loopBadge.style.display = 'flex';
      }
    });

    playlistToggleBtn.addEventListener('click', () => {
      playlistPanel.classList.toggle('open');
      playlistToggleBtn.classList.toggle('active');
    });

    playlistCloseBtn.addEventListener('click', () => {
      playlistPanel.classList.remove('open');
      playlistToggleBtn.classList.remove('active');
    });

    function checkMarquee() {
      title.classList.remove('marquee');
      setTimeout(() => {
        if (title.scrollWidth > titleContainer.clientWidth) {
          const distance = titleContainer.clientWidth - title.scrollWidth - 10;
          title.style.setProperty('--scroll-dist', `${distance}px`);
          title.classList.add('marquee');
        }
      }, 50);
    }

    function loadTrack(index) {
      const track = tracks[index];
      title.textContent = track.title;
      artist.textContent = track.artist;
      albumArt.src = track.cover;
      ambientBg.style.backgroundImage = `url(${track.cover})`;
      audio.src = track.url;
      updatePlaylistUI();
      setTimeout(checkMarquee, 100);
    }

    function playTrack() {
      isPlaying = true;
      audio.play();
      playIcon.classList.remove('fa-play');
      playIcon.classList.add('fa-pause');
      equalizer.classList.add('active');
    }

    function pauseTrack() {
      isPlaying = false;
      audio.pause();
      playIcon.classList.remove('fa-pause');
      playIcon.classList.add('fa-play');
      equalizer.classList.remove('active');
    }

    playBtn.addEventListener('click', () => {
      isPlaying ? pauseTrack() : playTrack();
    });

    prevBtn.addEventListener('click', () => {
      currentTrackIndex = (currentTrackIndex - 1 + tracks.length) % tracks.length;
      loadTrack(currentTrackIndex);
      playTrack();
    });

    function nextTrackLogic() {
      if (loopState === 2) {
        loadTrack(currentTrackIndex);
        playTrack();
        return;
      }

      if (isShuffle) {
        let randomIndex;
        do {
          randomIndex = Math.floor(Math.random() * tracks.length);
        } while (randomIndex === currentTrackIndex && tracks.length > 1);
        currentTrackIndex = randomIndex;
      } else {
        if (currentTrackIndex === tracks.length - 1 && loopState === 0) {
          pauseTrack();
          return;
        }
        currentTrackIndex = (currentTrackIndex + 1) % tracks.length;
      }
      loadTrack(currentTrackIndex);
      playTrack();
    }

    nextBtn.addEventListener('click', nextTrackLogic);

    audio.addEventListener('timeupdate', () => {
      if (audio.duration) {
        const progressPercent = (audio.currentTime / audio.duration) * 100;
        progressBar.style.width = `${progressPercent}%`;
        currentTimeEl.textContent = formatTime(audio.currentTime);
        durationEl.textContent = formatTime(audio.duration);
      }
    });

    progressWrapper.addEventListener('click', (e) => {
      const width = progressWrapper.clientWidth;
      const clickX = e.offsetX;
      audio.currentTime = (clickX / width) * audio.duration;
    });

    function updateVolumeUI(val) {
      audio.volume = val;
      volumeSlider.value = val;
      volumeProgressV.style.height = `${val * 100}%`;

      if (val == 0) {
        volumeIcon.className = 'fa-solid fa-volume-xmark volume-icon';
      } else if (val < 0.5) {
        volumeIcon.className = 'fa-solid fa-volume-low volume-icon';
      } else {
        volumeIcon.className = 'fa-solid fa-volume-high volume-icon';
      }
    }

    volumeSlider.addEventListener('input', (e) => {
      updateVolumeUI(e.target.value);
    });

    volumeIcon.addEventListener('click', () => {
      if (audio.volume > 0) {
        lastVolume = audio.volume;
        updateVolumeUI(0);
      } else {
        updateVolumeUI(lastVolume || 0.8);
      }
    });

    audio.addEventListener('ended', nextTrackLogic);

    document.addEventListener('keydown', (e) => {
      if (e.code === 'Space') {
        e.preventDefault();
        playBtn.click();
      } else if (e.code === 'ArrowRight') {
        audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
      } else if (e.code === 'ArrowLeft') {
        audio.currentTime = Math.max(0, audio.currentTime - 5);
      } else if (e.code === 'ArrowUp') {
        e.preventDefault();
        updateVolumeUI(Math.min(1, audio.volume + 0.1));
      } else if (e.code === 'ArrowDown') {
        e.preventDefault();
        updateVolumeUI(Math.max(0, audio.volume - 0.1));
      } else if (e.code === 'KeyM') {
        volumeIcon.click();
      }
    });

    function formatTime(seconds) {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    function renderPlaylist() {
      playlistEl.innerHTML = '';
      tracks.forEach((track, index) => {
        const item = document.createElement('div');
        item.classList.add('playlist-item');
        if (index === currentTrackIndex) item.classList.add('active');
        item.innerHTML = `<span>${track.title}</span><span style="font-size:0.72rem; opacity: 0.75;">${track.artist}</span>`;
        item.addEventListener('click', () => {
          currentTrackIndex = index;
          loadTrack(currentTrackIndex);
          playTrack();
          playlistPanel.classList.remove('open');
          playlistToggleBtn.classList.remove('active');
        });
        playlistEl.appendChild(item);
      });
    }

    function updatePlaylistUI() {
      const items = playlistEl.querySelectorAll('.playlist-item');
      items.forEach((item, index) => {
        if (index === currentTrackIndex) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });
    }

    loadTrack(currentTrackIndex);
    renderPlaylist();
    updateVolumeUI(volumeSlider.value);
  </script>
</body>
</html>
